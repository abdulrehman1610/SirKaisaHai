			"props": {
				"w": 850,
				"h": 165,
				"geo": "rectangle",
				"dash": "solid",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "violet",
				"labelColor": "black",
				"fill": "pattern",
				"size": "s",
				"font": "sans",
				"align": "start",
				"verticalAlign": "start",
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Zero-Knowledge Privacy Split:"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "reviews and verified_users have NO direct foreign key."
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Student email is SHA-256 hashed once at OTP verify; duplicate review prevention"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "uses decoupled teacher_submission_logs (user_id + professor_id only)."
								}
							]
						}
					]
				}
			},
			"parentId": "shape:frame_db",
			"index": "aAi0r",
			"typeName": "shape"
		},
		{
			"x": 0,
			"y": 2740,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:frame_flows",
			"type": "frame",
			"props": {
				"w": 1770,
				"h": 540,
				"name": "7. End-to-End Flows & Production Hardening Notes",
				"color": "light-violet"
			},
			"parentId": "page:page",
			"index": "a9Z3X",
			"typeName": "shape"
		},
		{
			"x": 25,
			"y": 30,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:flow_auth",
			"type": "geo",
			"props": {
				"w": 550,
				"h": 480,
				"geo": "rectangle",
				"dash": "solid",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "violet",
				"labelColor": "black",
				"fill": "semi",
				"size": "s",
				"font": "mono",
				"align": "start",
				"verticalAlign": "start",
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Flow A: Zero-Knowledge OTP Auth"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "-------------------------------------------"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "1. POST /api/auth/request-otp {email}"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "2. Domain must end with @superior.edu.pk"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "3. Check 5/15m IP + 5/15m email limits"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "4. Gen 6-digit OTP (10m) + SMTP TLS email"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "5. POST /api/auth/verify-otp {email, code}"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "6. Validate OTP + 5/15m lockout check"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "7. SHA-256 hash email -> VerifiedUser"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "8. Gen skh-session-<uuid>, store in DB"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "9. Burn OTP (consume_otp)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "10. Set httpOnly skh_session cookie (30d)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "11. GET /me checks cookie; POST /logout nulls"
								}
							]
						}
					]
				}
			},
			"parentId": "shape:frame_flows",
			"index": "a1",
			"typeName": "shape"
		},
		{
			"x": 610,
			"y": 30,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:flow_review",
			"type": "geo",
			"props": {
				"w": 550,
				"h": 480,
				"geo": "rectangle",
				"dash": "solid",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "green",
				"labelColor": "black",
				"fill": "semi",
				"size": "s",
				"font": "mono",
				"align": "start",
				"verticalAlign": "start",
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Flow B: Anonymous Review Submission"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "-------------------------------------------"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "1. POST /api/reviews {professorId, ...}"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "2. Pydantic checks ratings 1-5 & comment 5-500"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "3. services/profanity.py scans comment text"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "4. Verify professor exists in DB (else 404)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "5. Resolve VerifiedUser via skh_session"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "   cookie (fallback: userEmail SHA-256)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "6. Check TeacherSubmissionLog (1 per prof)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "7. Score: 0.4*T + 0.4*G + 0.2*(6 - Workload)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "8. Insert Review (NO FK to VerifiedUser)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "9. Insert TeacherSubmissionLog(user, prof)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "10. GET /professors computes fresh avgs"
								}
							]
						}
					]
				}
			},
			"parentId": "shape:frame_flows",
			"index": "a2Hwn",
			"typeName": "shape"
		},
		{
			"x": 1195,
			"y": 30,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:hardening_notes",
			"type": "geo",
			"props": {
				"w": 550,
				"h": 480,
				"geo": "rectangle",
				"dash": "solid",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "red",
				"labelColor": "black",
				"fill": "semi",
				"size": "s",
				"font": "mono",
				"align": "start",
				"verticalAlign": "start",
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "Current Caveats & Hardening TODOs"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "-------------------------------------------"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "1. POST /reviews lacks 401 check if not user"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "2. POST /reviews/{id}/vote ignores"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "   review_votes (unlimited repeat upvotes)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "3. OTP & attempt trackers are in-memory"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "   dicts (lost on restart / multi-worker)"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "4. OTP uses random.randint, not secrets"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "5. SECRET_SALT is not yet applied to hash"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "6. SameSite=Lax cookie fails cross-domain"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "7. seed_database() wipes DB if no dept-gd"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "8. N+1 SQL queries on GET /professors"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "9. ai_summary.py stub & update/news emails"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "   + python-jose/passlib currently unused"
								}
							]
						}
					]
				}
			},
			"parentId": "shape:frame_flows",
			"index": "a3AUk",
			"typeName": "shape"
		},
