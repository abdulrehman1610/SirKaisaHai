# ==============================================================================
# SirKaisaHai — Root .gitignore (FastAPI + Vue 3 / Vite Monorepo)
# ==============================================================================

# Environment variables & secrets (keep example templates)
.env
.env.*
!.env.example
!.env.*.example

# Python / FastAPI backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*.egg-info/
.eggs/
build/
sdist/
wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Node / Vue 3 / Vite / Vercel frontend
node_modules/
.pnp
.pnp.*
dist/
dist-ssr/
.vite/
.vercel/
.eslintcache
*.tsbuildinfo
*.local
*.timestamp-*-*.mjs

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI tool state & local prompt/context files
.kilo/
.kilocode/
/context.md
/desktop_prompt.md
/new_context.md
/stitch_prompt.md
/Documentations/
/project.tldr

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini


