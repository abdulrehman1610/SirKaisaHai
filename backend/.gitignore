# ====================================
# Backend .gitignore (Python / FastAPI)
# ====================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Local SQLite databases (Supabase PostgreSQL is used in cloud)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs, caches & testing
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
