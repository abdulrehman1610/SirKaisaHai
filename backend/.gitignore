# ====================================
# Backend .gitignore (Python / FastAPI)
# ====================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Local SQLite databases (Supabase PostgreSQL is used in cloud)
*.db
*.sqlite
*.sqlite3

# Logs & testing
*.log
.pytest_cache/
.coverage
htmlcov/

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
