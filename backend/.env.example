# Backend Environment Variables Template
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres.your_user:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# Required in production (generate 64+ hex chars via: python -c "import secrets; print(secrets.token_hex(32))")
EMAIL_HASH_SECRET=change-me-to-at-least-32-random-bytes-in-production
VOTE_SECRET=change-me-to-at-least-32-random-bytes-in-production
ADMIN_SECRET_KEY=change-me-to-at-least-32-random-bytes-in-production

# CORS & Cookies (Option A: Vercel /api/:path* reverse proxy keeps cookies first-party)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sirkaisahai.vercel.app
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Session & OTP policy
SESSION_EXPIRE_END_OF_DAY=true
SESSION_TIMEZONE=Asia/Karachi
SESSION_UTC_OFFSET_HOURS=5
OTP_TTL_SECONDS=600

# Rate limiting (use Upstash Redis URI in multi-worker production; memory:// for single-worker/dev)
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_IPS=*

# SMTP / Email delivery
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER_EMAIL=noreply@sirkaisahai.com
